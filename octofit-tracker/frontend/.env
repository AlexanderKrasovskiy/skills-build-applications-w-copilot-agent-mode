# React app environment variables
# In GitHub Codespace, CODESPACE_NAME is automatically available
# Get it from: echo $CODESPACE_NAME

# For local development, set this to your codespace name:
# REACT_APP_CODESPACE_NAME=your-codespace-name

# Backend URL will be constructed as: https://{REACT_APP_CODESPACE_NAME}-8000.app.github.dev
